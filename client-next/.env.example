# Sanity (existing)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_TOKEN=

# Sanity — server-only write token used by the admin dashboard.
# Generate with "Editor" (write) permissions at https://www.sanity.io/manage
# Never prefix this with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=

# Admin dashboard (/admin) — exactly two admin accounts
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=

ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=
